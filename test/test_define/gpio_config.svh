//==============================================================================
// File:    gpio_config.svh
// Description: GPIO 控制器宏定义配置文件
//             定义 GPIO 位宽、时钟分频及功能特性开关。
//             通过 `include 引入到 gpio_controller 模块中。
//==============================================================================

//---- GPIO 数据位宽 ----------------------------------------------------------
// 控制 GPIO 端口输入/输出数据的位宽（可综合范围：1 ~ 64）
`define GPIO_WIDTH 8

//---- 时钟分频系数 -----------------------------------------------------------
// 输入时钟分频比，用于去抖动或慢速外设接口
`define CLK_DIV 16

//---- 功能特性开关 -----------------------------------------------------------
// 取消注释以下定义以启用对应功能；注释掉则禁用

// 使能输入同步寄存器（两级触发器同步，防止亚稳态）
`define ENABLE_INPUT_SYNC

// 使能中断输出（任意输入引脚电平变化时产生中断脉冲）
`define ENABLE_INTERRUPT
